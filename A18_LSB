
#include <stdio.h>

int main()
{
    unsigned int num;
    int n, i;

    printf("Enter a number: ");
    scanf("%u", &num);

    printf("Enter number of bits: ");
    scanf("%d", &n);

    for (i = n - 1; i >= 0; i--)
    {
        printf("%u", (num >> i) & 1U);
    }

    printf("\n");

    return 0;
}
