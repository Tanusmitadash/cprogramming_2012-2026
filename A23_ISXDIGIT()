
#include <stdio.h>

int my_isxdigit(int ch)
{
    if ((ch >= '0' && ch <= '9') ||
        (ch >= 'A' && ch <= 'F') ||
        (ch >= 'a' && ch <= 'f'))
    {
        return 1;
    }

    return 0;
}

int main()
{
    char ch;

    printf("Enter a character: ");
    scanf("%c", &ch);

    if (my_isxdigit((unsigned char)ch))
        printf("Valid hexadecimal digit\n");
    else
        printf("Not a hexadecimal digit\n");

    return 0;
}
