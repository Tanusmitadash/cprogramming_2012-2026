
#include <stdio.h>

int my_islower(int ch)
{
    if (ch >= 'a' && ch <= 'z')
    {
        return 1;
    }

    return 0;
}

int main()
{
    char ch;

    printf("Enter a character: ");
    scanf("%c", &ch);

    if (my_islower((unsigned char)ch))
        printf("Lowercase character\n");
    else
        printf("Not a lowercase character\n");

    return 0;
}
